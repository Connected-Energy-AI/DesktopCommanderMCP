{
  "family": "qbwc-connector",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::AWS_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::AWS_ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "qbwc-connector",
      "image": "AWS_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/qbwc-connector:latest",
      "portMappings": [
        {
          "containerPort": 8443,
          "hostPort": 8443,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "QBWC_APP_NAME",
          "value": "Talian Technologies Connector"
        }
      ],
      "secrets": [
        {
          "name": "QBWC_USERNAME",
          "valueFrom": "arn:aws:ssm:us-east-1:AWS_ACCOUNT_ID:parameter/qbwc/username"
        },
        {
          "name": "QBWC_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-1:AWS_ACCOUNT_ID:parameter/qbwc/password"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/qbwc-connector",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8443/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      }
    }
  ]
}
