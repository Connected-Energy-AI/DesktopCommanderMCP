# Figma (for MCP/plugin or integrations)
# Get Team ID from URL: https://www.figma.com/files/team/<TEAM_ID>/...
# Get token: Figma → account menu → Settings → Security → Personal access tokens → Generate new token
FIGMA_TEAM_ID=
FIGMA_PERSONAL_ACCESS_TOKEN=

# AgentMail – https://console.agentmail.to/ → Dashboard → API Keys (create or copy; often starts with am_)
AGENTMAIL_API_KEY=
