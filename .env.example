# Figma (for MCP/plugin or integrations)
# Get Team ID from URL: https://www.figma.com/files/team/<TEAM_ID>/...
# Get token: Figma → account menu → Settings → Security → Personal access tokens → Generate new token
FIGMA_TEAM_ID=
FIGMA_PERSONAL_ACCESS_TOKEN=

# AgentMail – https://console.agentmail.to/ → Dashboard → API Keys (create or copy; often starts with am_)
AGENTMAIL_API_KEY=

# --- CRM / data ops (MCP or scripts; never commit real tokens) ---
# HubSpot: Private app token or OAuth — developer.hubspot.com
# HUBSPOT_ACCESS_TOKEN=
# Attio: workspace API key — developers.attio.com
# ATTIO_API_KEY=
# Airtable: personal access token + base ID — airtable.com/create/tokens
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=

# --- Zapier MCP audit scripts (optional; see docs/ZAPIER_MCP_AUDIT.md) ---
# MCP URL for Mistral/other HTTP MCP hosts: https://mcp.zapier.com/api/v1/connect
# ZAPIER_MCP_1P_VAULT=          # 1Password vault name for op item list
# ZAPIER_MCP_1P_TAG=dev-api     # single tag; or use ZAPIER_MCP_1P_TAGS below
# ZAPIER_MCP_1P_TAGS=dev,api,mcp   # comma-separated — multi-tag inventory script
